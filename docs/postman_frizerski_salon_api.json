{
  "info": {
    "name": "Frizerski salon - Angular API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://YOUR_HOSTED_DOMAIN" },
    { "key": "token", "value": "" },
    { "key": "zaposleni_id", "value": "1" },
    { "key": "usluga_id", "value": "1" }
  ],
  "item": [
    {
      "name": "POST /api/register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/register",
        "body": {
          "mode": "raw",
          "raw": "{\"ime\":\"Test\",\"prezime\":\"Klijent\",\"email\":\"test.klijent{{$timestamp}}@salon.test\",\"telefon\":\"060100200\",\"password\":\"password\",\"password_confirmation\":\"password\"}"
        }
      }
    },
    {
      "name": "POST /api/login",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Login vraca token', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().token).to.be.a('string');",
            "});",
            "pm.collectionVariables.set('token', pm.response.json().token);"
          ],
          "type": "text/javascript"
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"ana@salon.test\",\"password\":\"password\"}"
        }
      }
    },
    {
      "name": "GET /api/user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/user"
      }
    },
    {
      "name": "GET /api/usluge",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/usluge"
      }
    },
    {
      "name": "GET /api/zaposleni",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/zaposleni"
      }
    },
    {
      "name": "GET /api/dostupni-termini",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/dostupni-termini?datum=2027-07-20&zaposleni_id={{zaposleni_id}}&usluga_id={{usluga_id}}"
      }
    },
    {
      "name": "POST /api/termini",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/termini",
        "body": {
          "mode": "raw",
          "raw": "{\"datum\":\"2027-07-20\",\"vreme_pocetka\":\"09:00\",\"zaposleni_id\":{{zaposleni_id}},\"usluga_id\":{{usluga_id}},\"napomena\":\"Postman test\"}"
        }
      }
    },
    {
      "name": "POST /api/logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{base_url}}/api/logout"
      }
    }
  ]
}
